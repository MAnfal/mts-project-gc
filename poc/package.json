{
  "name": "poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "evals": "vitest run --config vitest.evals.config.mts",
    "evals:json": "vitest run --config vitest.evals.config.mts --reporter=vitest-evals/reporter --reporter=json --outputFile.json=eval-results/vitest-results.json",
    "evals:ui": "vitest-evals serve eval-results/vitest-results.json",
    "run": "tsx scripts/run.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/gateway": "^4.0.152",
    "@ai-sdk/openai": "^4.0.122",
    "ai": "^7.0.179",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "next": "16.4.6",
    "p-limit": "^7.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest-evals/harness-ai-sdk": "^0.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "vitest-evals": "^0.18.1"
  },
  "packageManager": "pnpm@9.15.4"
